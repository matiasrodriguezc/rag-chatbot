# Dockerfile.api - Para deploy en Vercel/Railway/etc
FROM python:3.11-slim

WORKDIR /app

# Instala dependencias del sistema mínimas
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copiamos requirements de la API
COPY requirements-api.txt /app/requirements.txt

RUN pip install --no-cache-dir -r /app/requirements.txt

# Copiamos el código
COPY main.py /app/

# Puerto dinámico (Railway usa $PORT, Vercel usa 8000)
ENV PORT=8000
EXPOSE $PORT

# Comando de arranque (usa PORT si está disponible)
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}
